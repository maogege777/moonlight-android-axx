<!-- EXTENSION DEVELOPMENT [EXT-QUICK-KEYS-IN-OPERATIONS] [MODIFIED] BEGIN -->
<!-- 「操作」面板「自定义快捷键」分组的网格按钮：图标 + 名称 + 副标题。
     尺寸与「快捷操作」等原有分组的 54dp 四列网格保持一致。
     主标题取名称（内置项取括号前的按键组合），副标题取用途或组合键值。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_weight="1"
    android:background="@drawable/ic_game_menu_btn_selector"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/iv_quick_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_axi_qk_default" />

    <TextView
        android:id="@+id/tx_quick_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="9dp"
        tools:text="Ctrl+Shift+ESC" />

    <TextView
        android:id="@+id/tx_quick_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#9AA0A6"
        android:textSize="7dp"
        tools:text="任务管理器" />

</LinearLayout>
<!-- EXTENSION DEVELOPMENT [EXT-QUICK-KEYS-IN-OPERATIONS] [MODIFIED] END -->
